@model siteplatform.Models.PricePatternPageModel
@using siteplatform.Models
@{
    var selected = Model.SelectedPattern;
    ViewData["Title"] = selected == null ? "Price Patterns" : selected.Pattern.Name + " · Price Patterns";
    var total = Model.Scanner.TotalIdentifiedPatterns;
    var headerDescription = selected == null
        ? "Browse instruments by the latest active chart patterns and options-wall positioning."
        : selected.Pattern.Category + " · Instruments with this active price-pattern signal.";
    var groups = Model.Scanner.Patterns.Where(x => x.Count > 0)
        .GroupBy(x => x.Category).ToList();
}
<header class="instrument-page-header">
    <div class="container instrument-page-header-inner">
        @if (selected != null)
        {
            <nav class="instrument-breadcrumbs" aria-label="Breadcrumb">
                <a href="/scanner/price_patterns">Price Patterns</a><span aria-hidden="true">/</span><span class="instrument-breadcrumb-current">@selected.Pattern.Name</span>
            </nav>
        }
        <span class="instrument-category-badge">Technical pattern scanner</span>
        <h1 class="instrument-title">@(selected == null ? "Price Patterns" : selected.Pattern.Name)</h1>
        <div class="instrument-meta-row">
            <div class="instrument-meta-primary">
                <span class="instrument-meta-avatar" aria-hidden="true"><i class="fas fa-wave-square"></i></span>
                <span class="instrument-meta-copy">@headerDescription</span>
            </div>
            <div class="instrument-meta-stats pattern-heading-stats">
                @if (selected == null)
                {
                    <span class="instrument-meta-stat">
                        <span>Total identified patterns</span>
                        <strong>@total</strong>
                    </span>
                    <span class="pattern-heading-substat">@Model.Scanner.TotalInstruments instruments</span>
                }
                else
                {
                    <span class="instrument-meta-stat">
                        <span>Instruments with this pattern</span>
                        <strong>@selected.Count</strong>
                    </span>
                    <span class="pattern-heading-substat">@(selected.Count == 1 ? "matching instrument" : "matching instruments")</span>
                }
            </div>
        </div>
    </div>
</header>

<section class="container country-market-page price-patterns-page">
    @if (selected == null)
    {
        @if (groups.Count == 0)
        {
            <div class="country-market-empty">No active price patterns are currently identified.</div>
        }
        else
        {
            <div class="pattern-scanner-groups">
                @foreach (var group in groups)
                {
                    <section class="pattern-group">
                        <h2 class="pattern-group-title">@group.Key</h2>
                        <div class="pattern-grid pattern-scanner-grid">
                            @foreach (var pattern in group.OrderByDescending(x => x.Count).ThenBy(x => x.Name))
                            {
                                <a class="pattern-btn pattern-scanner-card tone-@pattern.Tone"
                                   href="/scanner/price_patterns/@Uri.EscapeDataString(pattern.Slug)">
                                    <span class="pattern-icon">@Html.Raw(PricePatternVisuals.Svg(pattern.Key))</span>
                                    <span class="pattern-label">@pattern.Name</span>
                                    <strong class="pattern-count">@pattern.Count</strong>
                                </a>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    }
    else
    {
        <div class="pattern-detail-toolbar">
            <a href="/scanner/price_patterns"><i class="fas fa-arrow-left" aria-hidden="true"></i> All price patterns</a>
        </div>
        @if (selected.Instruments.Count == 0)
        {
            <div class="country-market-empty">No instruments currently match this pattern.</div>
        }
        else
        {
            <section class="country-market-group pattern-instrument-group">
                <div class="country-market-company-list">
                    @foreach (var item in selected.Instruments)
                    {
                        <a class="country-market-company" href="/instrument/@Uri.EscapeDataString(item.CountryCode)/@Uri.EscapeDataString(item.Exchange)/@Uri.EscapeDataString(item.Symbol)">
                            <span class="country-market-company-name">@item.Name <small>@item.Symbol · @item.Exchange · @item.CountryCode</small></span>
                            <span class="country-market-company-move">
                                @if (item.LatestClose.HasValue)
                                {
                                    <span>@item.LatestClose.Value.ToString("N3")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.LatestCloseDate))
                                {
                                    <small>@item.LatestCloseDate</small>
                                }
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</section>
