<div class="instrument-search">
    <label for="instrument-query" class="sr-only">Search instruments</label>
    <i class="fas fa-search" aria-hidden="true"></i>
    <input id="instrument-query" type="search" placeholder="Search stocks, ETFs…" maxlength="100" autocomplete="off"
           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="instrument-results" aria-describedby="instrument-search-status">
    <ul id="instrument-results" class="instrument-results" role="listbox" hidden></ul>
    <span id="instrument-search-status" class="sr-only" role="status" aria-live="polite"></span>
</div>
