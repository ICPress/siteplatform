@model siteplatform.Models.CompleteProfileModel
@{ ViewData["Title"] = "Complete your profile"; }
<section class="auth-section container">
    <div class="auth-card">
        <span class="beta-kicker">ICPress account</span>
        <h1>Complete your profile</h1>
        <p>Your email is verified: <strong class="verified-email">@ViewBag.VerifiedEmail</strong></p>
        <p>Choose a username and enter your full name to join the beta waiting list.</p>
        <form method="post" action="/Account/complete" class="auth-form" data-onboarding-form>
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-errors" role="alert"></div> }
            <label asp-for="Username">Username</label>
            <input asp-for="Username" required pattern="[a-zA-Z0-9_]{3,20}" minlength="3" maxlength="20" autocomplete="username" aria-describedby="username-hint">
            <small id="username-hint">3–20 letters, numbers or underscores.</small>
            <label asp-for="FullName">Full name</label>
            <input asp-for="FullName" required maxlength="200" autocomplete="name">
            <div data-profile-image="avatar" data-prepare-url="@Url.RouteUrl("RegistrationImagePrepare")">
                <label for="avatar-file">Profile photo <span>(optional)</span></label>
                <div class="registration-avatar"><img id="avatar-preview" alt="Profile photo preview" hidden></div>
                <input id="avatar-file" type="file" accept="image/jpeg,image/png" aria-describedby="avatar-status">
                <input asp-for="AvatarTicket" type="hidden">
                <button type="button" class="text-button" data-upload-retry hidden>Retry photo upload</button>
                <button type="button" class="text-button" data-image-clear>Continue without a photo</button>
                <p id="avatar-status" class="upload-status" role="status"></p>
            </div>
            <button class="btn btn-primary" type="submit">Continue</button>
        </form>
        <a class="auth-back" href="/Account/signin">Sign in with a different account</a>
    </div>
</section>

<partial name="_ProfileCropper" />
@section Scripts { <script src="/assets/js/profile-images.js" asp-append-version="true" defer></script> }
