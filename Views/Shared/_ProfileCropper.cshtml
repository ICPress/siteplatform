<dialog id="profile-crop-dialog" class="profile-crop-dialog" aria-labelledby="crop-title" aria-describedby="crop-instructions">
    <h2 id="crop-title">Crop your profile picture</h2>
    <p id="crop-instructions">Drag to reposition, then zoom to fit. The centered area will be saved. You can also use the arrow keys.</p>
    <div class="crop-zoom"><label for="crop-zoom">Zoom</label><input id="crop-zoom" type="range" min="1" max="3" step="0.05" value="1"><output id="crop-zoom-value" for="crop-zoom">100%</output></div>
    <div class="crop-stage"><canvas id="profile-crop-canvas" width="400" height="300" tabindex="0" aria-label="Drag image or use arrow keys to position crop"></canvas><div class="crop-mask" aria-hidden="true"></div></div>
    <p id="crop-error" role="status"></p>
    <div class="crop-actions"><button type="button" class="text-button" id="crop-cancel">Cancel</button><button type="button" class="btn btn-primary" id="crop-apply">Use photo</button></div>
</dialog>
