@{ ViewData["Title"] = "Signing you in"; }
<section class="auth-section container"><div class="auth-card">
    <span class="beta-kicker">ICPress account</span>
    @if (!string.IsNullOrEmpty((string?)ViewBag.AuthToken)) {
        <h1>Signing you in…</h1><p role="status">We’re confirming your email link.</p>
        <form method="post" action="/Account/verify" class="auth-form" id="email-verification-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="authToken" value="@ViewBag.AuthToken">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">
            <button class="btn btn-primary" type="submit">Continue to website / app</button>
        </form>
    } else {
        <h1>This link is incomplete</h1><p>Open the complete sign-in link from your email.</p><a class="btn btn-primary" href="/Account/signin">Back to sign in</a>
    }
</div></section>
@section Scripts { <script src="/assets/js/email-verification.js" asp-append-version="true" defer></script> }
