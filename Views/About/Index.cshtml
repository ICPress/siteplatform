@{
    ViewData["Title"] = "About ICPress — Open-Source Publishing Platform";
}

@section Styles {
<style>
    /* ===== ABOUT PAGE ===== */

    .about-header {
        padding: 50px 0 40px;
        background: linear-gradient(135deg, var(--bg-header) 0%, #0d3080 100%);
        color: var(--text-light);
        margin-bottom: 0;
    }
    .about-header .page-title {
        font-size: 2.4rem; margin-bottom: 12px; color: var(--text-light);
    }
    .about-header .page-subtitle {
        font-size: 1.1rem; color: rgba(255,255,255,0.8); max-width: 680px; margin-bottom: 0;
    }

    /* Layout wrapper */
    .about-body { padding: 0 0 64px; }
    .about-container {
        display: flex; gap: 40px; align-items: flex-start;
        max-width: 1200px; margin: 0 auto; padding: 40px 15px 0;
    }

    /* Sidebar — reuses .sidebar-widget pattern but needs sticky + narrower width */
    .about-sidebar { width: 230px; flex-shrink: 0; }
    .about-sidebar .sidebar-widget { position: sticky; top: 80px; }
    .wiki-nav-divider { height: 1px; background: var(--border-color); margin: 10px 0; }
    .wiki-nav-link {
        display: block; padding: 8px 12px; border-radius: 6px;
        font-size: 0.87rem; color: var(--text-secondary); transition: all 0.2s;
        text-decoration: none;
    }
    .wiki-nav-link:hover, .wiki-nav-link.active {
        background: var(--bg-tertiary); color: var(--accent-color);
    }

    /* Content column */
    .wiki-content { flex: 1; min-width: 0; }

    /* Wiki section card — same shadow/radius as .sidebar-widget but no border-top override here */
    .wiki-section {
        background: var(--bg-secondary); border-radius: 12px;
        padding: 32px 36px; margin-bottom: 24px;
        box-shadow: 0 4px 12px var(--shadow-color);
        scroll-margin-top: 80px;
        border-top: 3px solid var(--accent-color);
    }
    .wiki-section.oss-section { border-top-color: #38a169; }

    /* Section title — reuses .section-title sizing but as a block element here */
    .wiki-section-title {
        font-size: 1.5rem; color: var(--text-primary);
        padding-bottom: 12px; margin-bottom: 20px;
        border-bottom: 2px solid var(--accent-color);
        display: inline-block;
    }
    .wiki-section.oss-section .wiki-section-title { border-bottom-color: #38a169; }

    .wiki-subsection { margin-bottom: 26px; }
    .wiki-subsection:last-child { margin-bottom: 0; }
    .wiki-subsection-title {
        font-size: 1rem; color: var(--accent-color);
        margin-bottom: 10px; font-weight: 700;
    }

    /* Definition callout */
    .definition-block {
        background: var(--bg-primary); border-radius: 8px;
        padding: 18px 22px; margin-bottom: 18px;
        border-left: 4px solid var(--accent-color);
    }
    .definition-block p {
        font-size: 1.05rem !important; font-weight: 500;
        color: var(--text-primary) !important; margin: 0 !important; line-height: 1.6;
    }

    /* Audience grid */
    .audience-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; margin-top: 20px; }
    .audience-card {
        background: var(--bg-primary); border-radius: 10px; padding: 20px 22px;
        border-top: 3px solid var(--accent-color);
    }
    .audience-card-label {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.8px; color: var(--accent-color); margin-bottom: 8px;
    }
    .audience-card h4 { font-size: 0.97rem; margin-bottom: 8px; }
    .audience-card p { font-size: 0.87rem !important; margin: 0 !important; }

    /* Values grid — same pattern as .article-grid but 3 col */
    .values-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
    .value-card {
        background: var(--bg-primary); border-radius: 10px; padding: 18px 20px;
        border-top: 3px solid var(--accent-color);
    }
    .value-icon {
        width: 38px; height: 38px; border-radius: 8px;
        background: var(--bg-tertiary); color: var(--accent-color);
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; margin-bottom: 12px;
    }
    .value-title { font-size: 0.92rem; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .value-card p { font-size: 0.84rem !important; margin: 0 !important; }

    /* Infrastructure grid */
    .infra-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; margin-top: 16px; }
    .infra-card { background: var(--bg-primary); border-radius: 8px; padding: 18px 20px; }
    .infra-card-title {
        font-size: 0.9rem; font-weight: 700; color: var(--text-primary);
        margin-bottom: 6px; display: flex; align-items: center; gap: 8px;
    }
    .infra-card-title i { color: var(--accent-color); }
    .infra-card p { font-size: 0.85rem !important; margin: 0 !important; }

    /* Open source block */
    .oss-block {
        border: 1px solid #38a169; border-radius: 10px;
        padding: 20px 22px; margin-top: 18px; background: rgba(56,161,105,0.04);
    }
    .oss-block-title {
        font-size: 0.97rem; font-weight: 700; color: #38a169;
        margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
    }
    .github-btn {
        display: inline-flex; align-items: center; gap: 9px;
        padding: 10px 20px; background: #24292e; color: white;
        border-radius: 6px; font-weight: 600; font-size: 0.88rem;
        text-decoration: none; transition: all 0.2s; margin-top: 12px;
    }
    .github-btn:hover { background: #1a1e22; color: white; }

    /* Rewards dark card */
    .rewards-card {
        background: linear-gradient(135deg, #0A2463 0%, #1a4080 100%);
        border-radius: 12px; padding: 28px 32px; color: white; margin-top: 16px;
        position: relative; overflow: hidden;
    }
    .rewards-card::before {
        content: ''; position: absolute; top: -50px; right: -50px;
        width: 200px; height: 200px; background: rgba(62,146,204,0.12); border-radius: 50%;
    }
    .rewards-card h3 { font-size: 1.1rem; color: white; margin-bottom: 10px; }
    .rewards-card p { color: rgba(255,255,255,0.85) !important; font-size: 0.9rem !important; line-height: 1.7; }
    .rewards-detail-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-top: 18px; }
    .rewards-detail {
        padding: 14px 16px; background: rgba(255,255,255,0.08);
        border-radius: 8px; border-left: 3px solid rgba(88,214,141,0.7);
    }
    .rewards-detail-title {
        font-size: 0.76rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.5px; color: #58d68d; margin-bottom: 6px;
    }
    .rewards-detail p { font-size: 0.84rem !important; margin: 0 !important; color: rgba(255,255,255,0.8) !important; }

    /* Contribute block */
    .contribute-block {
        background: var(--bg-primary); border-radius: 10px;
        padding: 22px 24px; margin-top: 18px; border-top: 3px solid var(--accent-color);
    }
    .contribute-block h4 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    /* Perks reuse .tag-cloud + .tag from style.css */
    .contribute-cta {
        display: inline-block; padding: 11px 24px;
        background: var(--accent-color); color: white;
        border-radius: 6px; font-weight: 600; font-size: 0.9rem;
        text-decoration: none; transition: all 0.2s;
    }
    .contribute-cta:hover { background: var(--accent-hover); color: white; }

    /* Timeline */
    .timeline { position: relative; padding-left: 28px; margin-top: 18px; }
    .timeline::before {
        content: ''; position: absolute; left: 5px; top: 0; bottom: 0;
        width: 2px; background: var(--border-color);
    }
    .timeline-item { position: relative; margin-bottom: 26px; }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-marker {
        position: absolute; left: -25px; top: 4px;
        width: 12px; height: 12px; border-radius: 50%;
        background: var(--accent-color); border: 2px solid var(--bg-secondary);
        box-shadow: 0 0 0 3px rgba(62,146,204,0.2);
    }
    .timeline-year {
        font-size: 0.75rem; font-weight: 700; color: var(--accent-color);
        margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .timeline-content h4 { font-size: 0.93rem; margin-bottom: 4px; }
    .timeline-content p  { font-size: 0.87rem !important; margin: 0 !important; }

    /* Founder card — reuses .author-widget layout from style.css */
    .founder-card {
        display: flex; gap: 22px; align-items: flex-start;
        padding: 22px; background: var(--bg-primary);
        border-radius: 10px; margin-top: 18px; border-left: 4px solid var(--accent-color);
    }
    .founder-avatar {
        width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--accent-color), #0A2463);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; color: white; font-weight: 700;
    }
    .founder-name { font-size: 1.05rem; font-weight: 700; margin-bottom: 3px; }
    .founder-role { font-size: 0.8rem; color: var(--accent-color); font-weight: 600; margin-bottom: 8px; }
    .founder-bio { font-size: 0.89rem; color: var(--text-secondary); margin: 0; line-height: 1.65; }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .about-container { flex-direction: column; }
        .about-sidebar { width: 100%; }
        .about-sidebar .sidebar-widget { position: static; }
        .audience-grid { grid-template-columns: 1fr; }
        .values-grid { grid-template-columns: repeat(2,1fr); }
        .infra-grid { grid-template-columns: 1fr; }
        .rewards-detail-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 600px) {
        .wiki-section { padding: 20px; }
        .values-grid { grid-template-columns: 1fr; }
        .founder-card { flex-direction: column; }
        .rewards-card { padding: 22px; }
    }
</style>
}

<section class="about-header">
    <div class="container">
        <h1 class="page-title">About ICPress</h1>
        <p class="page-subtitle">A decentralized, open-source media ecosystem delivering finance, tech, and crypto journalism.</p>
    </div>
</section>

<section class="about-body">
    <div class="about-container">

        @* Sidebar — uses existing .sidebar-widget + .widget-title from style.css *@
        <aside class="about-sidebar">
            <div class="sidebar-widget">
                <div class="widget-title">Contents</div>
                <ul class="wiki-nav-list" style="list-style:none;padding:0;margin:0;">
                    <li><a href="#what-is-icpress"   class="wiki-nav-link active">What is ICPress</a></li>
                    <li><a href="#why-exists"        class="wiki-nav-link">Why ICPress Exists</a></li>
                    <li><a href="#how-it-works"      class="wiki-nav-link">How Publishing Works</a></li>
                    <li><a href="#what-you-get"      class="wiki-nav-link">What You Get</a></li>
                    <li><a href="#built-in"          class="wiki-nav-link">Built Into Every Article</a></li>
                    <li><a href="#open-source"       class="wiki-nav-link"><i class="fab fa-github" style="margin-right:5px;color:#38a169;"></i>Open Source</a></li>
                    <li class="wiki-nav-divider"></li>
                    <li><a href="#our-story"         class="wiki-nav-link">Our Story</a></li>
                    <li class="wiki-nav-divider"></li>
                    <li><a href="#contributor-ownership" class="wiki-nav-link">Contributor Ownership</a></li>
                    <li><a href="#contribute"        class="wiki-nav-link">Contribute</a></li>
                </ul>
            </div>
        </aside>

        <main class="wiki-content">

            @* ── What is ICPress ── *@
            <section id="what-is-icpress" class="wiki-section">
                <h2 class="wiki-section-title">What is ICPress</h2>
                <p>ICPress is a decentralized, open-source media ecosystem delivering finance, tech, and crypto journalism. We replaced institutional gatekeepers with transparent, community-driven peer review — so you get uncompromised analysis that is actually accurate, sourced, and verifiable.</p>
                
                <p>We are operated by <strong>StoryPop AB</strong>, registered in Sweden. Our codebase is publicly available and licensed for self-hosting. No single organization controls the infrastructure.</p>
            </section>

            @* ── Why ICPress Exists ── *@
            <section id="why-exists" class="wiki-section">
                <h2 class="wiki-section-title">Why ICPress Exists</h2>
                <p>Important information often stays inside close circles — shared among specialists, insiders, and privileged networks rather than the public it concerns. The tools for producing credible journalism — editorial process, sourcing standards, structured review — have historically been available only to established media organizations.</p>
                <p>ICPress makes those tools accessible to anyone with a story to tell, ensuring independent voices don't have to sacrifice credibility to publish outside the traditional newsroom.</p>
            </section>

            @* ── How Publishing Works ── *@
            <section id="how-it-works" class="wiki-section">
                <h2 class="wiki-section-title">How Publishing Works</h2>
                <p>Contributors submit articles, optionally using AI assistance for drafting and structure. Each article enters a peer-review process where experienced contributors evaluate it against published editorial criteria: <strong>accuracy</strong> (claims supported by cited sources), <strong>sourcing</strong> (reliable references), and <strong>clarity</strong> (reporting distinguished from opinion).</p>
                <p>The outcome: approved for publication, returned with feedback for revision, or declined with a written reason. Reviewer comments are visible throughout.</p>
                <div class="definition-block">
                    <p>Independent does not mean unverified. We don't filter for perspective, narrative, or alignment with corporate interests. We filter for whether claims are supported and sources are real. What you conclude is entirely your own.</p>
                </div>
            </section>

            @* ── What You Get ── *@
            <section id="what-you-get" class="wiki-section">
                <h2 class="wiki-section-title">What You Get</h2>
                <div class="audience-grid">
                    <div class="audience-card">
                        <div class="audience-card-label"><i class="fas fa-newspaper" style="margin-right:5px;"></i>Readers</div>
                        <h4>Real-time, verifiable analysis</h4>
                        <p>Real-time crypto, macro-finance, and deep tech analysis. Every published article has passed peer review. Every source is cited and inspectable. No paywalls. No corporate bias shaping what reaches you.</p>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-label"><i class="fas fa-pen-nib" style="margin-right:5px;"></i>Contributors &amp; Journalists</div>
                        <h4>Publish independently, without a newsroom</h4>
                        <p>The AI assistant helps with structure and clarity; peer review gives your work editorial credibility. You keep full authorship and attribution. Active contributors are eligible for equity in the platform.</p>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-label"><i class="fas fa-code" style="margin-right:5px;"></i>Developers</div>
                        <h4>Fork it, extend it, self-host it</h4>
                        <p>The full codebase is on GitHub. Fork it, deploy your own instance, extend the API, or contribute back. Self-hosting documentation included. Deploy on any Linux server, container environment, or cloud provider.</p>
                    </div>
                </div>
            </section>

            @* ── Built Into Every Article ── *@
            <section id="built-in" class="wiki-section">
                <h2 class="wiki-section-title">Built Into Every Article</h2>
                <div class="infra-grid">
                    <div class="infra-card">
                        <div class="infra-card-title"><i class="fas fa-robot"></i> AI Writing Assistant</div>
                        <p>Helps with structure and clarity. A drafting aid, not a replacement for reporting or fact-checking, which remain the contributor's responsibility.</p>
                    </div>
                    <div class="infra-card">
                        <div class="infra-card-title"><i class="fas fa-map-marked-alt"></i> Interactive Article Maps</div>
                        <p>Leaflet-powered geographic maps with GeoJSON support for location-based and event coverage.</p>
                    </div>
                    <div class="infra-card">
                        <div class="infra-card-title"><i class="fas fa-link"></i> Source Verification</div>
                        <p>Contributors cite and link sources within the article. Readers inspect every source directly from the published page.</p>
                    </div>
                    <div class="infra-card">
                        <div class="infra-card-title"><i class="fas fa-mobile-alt"></i> Mobile-First Workflow</div>
                        <p>Write, edit, and submit articles entirely from your phone.</p>
                    </div>
                </div>
            </section>

            @* ── Open Source ── *@
            <section id="open-source" class="wiki-section oss-section">
                <h2 class="wiki-section-title">
                    <i class="fab fa-github" style="margin-right:8px;color:#38a169;"></i>Open Source
                </h2>
                <p>Our codebase is publicly available and licensed for self-hosting. No single organization controls the infrastructure. Fork it, deploy your own instance, extend the API, or contribute back.</p>
                <div class="oss-block">
                    <div class="oss-block-title"><i class="fab fa-github"></i>github.com/ICPress</div>
                    <p>The repository includes the full application source, a self-hosting setup guide, and API documentation. ICPress can be deployed on any Linux server, container environment, or cloud provider.</p>
                    <a href="https://github.com/ICPress" target="_blank" rel="noopener noreferrer" class="github-btn">
                        <i class="fab fa-github"></i> View on GitHub
                    </a>
                </div>
                <div class="wiki-subsection" style="margin-top:22px;">
                    <h3 class="wiki-subsection-title">Language &amp; Localization</h3>
                    <p>The main platform operates in English. We are working toward community-hosted language versions so local journalism communities can run ICPress in their own language. Interested in contributing a localization or hosting a regional instance? Open an issue on GitHub.</p>
                </div>
            </section>

            @* ── Our Story ── *@
            <section id="our-story" class="wiki-section">
                <h2 class="wiki-section-title">Our Story</h2>
                <p>ICPress was created by <strong>Senad Matuh Delic</strong> — built from the recognition that the tools of credible journalism should not be exclusive to established organizations.</p>
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-year">2022</div>
                        <div class="timeline-content">
                            <h4>Concept &amp; Development</h4>
                            <p>Senad begins building StoryPop, focused on structured publishing tools for independent contributors.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-year">2023</div>
                        <div class="timeline-content">
                            <h4>Android Beta Launch</h4>
                            <p>Android beta launch as a social media publishing platform. First contributors join.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-year">2024</div>
                        <div class="timeline-content">
                            <h4>Contributor Equity Programme</h4>
                            <p>Contributor equity programme defined — Stakeholder Token (SSTK) structure established in company charter.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-year">2026 →</div>
                        <div class="timeline-content">
                            <h4>ICPress News Platform Launch</h4>
                            <p>Platform pivots to peer-reviewed news publishing under the ICPress name.</p>
                        </div>
                    </div>
                </div>
                <div class="wiki-subsection">
                    <h3 class="wiki-subsection-title">Founder</h3>
                    <div class="founder-card">
                        <div class="founder-avatar">S</div>
                        <div>
                            <div class="founder-name">Senad Matuh Delic</div>
                            <div class="founder-role">Founder &amp; CEO</div>
                            <p class="founder-bio">Senad built ICPress to bring editorial structure and peer review to independent journalism — providing the tools and process previously only available inside traditional newsrooms, and making them accessible to any contributor with a story to tell.</p>
                        </div>
                    </div>
                </div>
            </section>

            @* ── Contributor Ownership ── *@
            <section id="contributor-ownership" class="wiki-section">
                <h2 class="wiki-section-title">Contributor Ownership</h2>
                <p>ICPress is structured as a for-profit media company with a contributor equity component. A significant portion of the company's equity is reserved for community contributors through Stakeholder Tokens (SSTKs), defined in the company charter.</p>
                <div class="rewards-card">
                    <h3>Stakeholder Tokens (SSTK)</h3>
                    <p>SSTKs are distributed based on contributor activity and impact — not purchased. Contributors who build the platform's content library hold a real stake in its long-term value. The platform accepts outside investment under a conventional corporate structure alongside the contributor equity programme.</p>
                    <div class="rewards-detail-grid">
                        <div class="rewards-detail">
                            <div class="rewards-detail-title">Distribution</div>
                            <p>Tokens are distributed based on contributor activity and impact — not purchased.</p>
                        </div>
                        <div class="rewards-detail">
                            <div class="rewards-detail-title">Investor Participation</div>
                            <p>The platform accepts outside investment under a conventional corporate structure alongside the contributor equity programme.</p>
                        </div>
                        <div class="rewards-detail">
                            <div class="rewards-detail-title">Governance</div>
                            <p>Governance, distribution, and future equity mechanisms are detailed in governing agreements and shared at onboarding.</p>
                        </div>
                    </div>
                </div>
                <p style="margin-top:16px;font-size:0.88rem;color:var(--text-secondary);">The platform does not sell contributor data.</p>
            </section>

            @* ── Contribute ── *@
            <section id="contribute" class="wiki-section">
                <h2 class="wiki-section-title">Contribute</h2>
                <p>ICPress is currently in <strong>open beta</strong>. Anyone can submit an article for peer review — no journalism credential, press pass, or invitation required. Only a willingness to report accurately and cite your sources.</p>
                <div class="contribute-block">
                    <h4><i class="fas fa-pen-nib" style="margin-right:8px;color:var(--accent-color);"></i>Submit your first article</h4>
                    <p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:0;">Create an account, draft an article using the built-in editor, cite your sources, and submit for peer review. When your article is approved, it is published under your name and visible to readers worldwide.</p>
                    @* <a href="/account/register" class="contribute-cta">Start writing →</a> *@
                </div>
            </section>

        </main>
    </div>
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    var links    = document.querySelectorAll('.wiki-nav-link');
    var sections = document.querySelectorAll('.wiki-section');

    function updateActive() {
        var current = '';
        sections.forEach(function (s) {
            if (window.scrollY >= s.offsetTop - 100) current = s.id;
        });
        links.forEach(function (l) {
            l.classList.toggle('active', l.getAttribute('href') === '#' + current);
        });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();

    links.forEach(function (l) {
        l.addEventListener('click', function (e) {
            e.preventDefault();
            var target = document.querySelector(this.getAttribute('href'));
            if (target) window.scrollTo({ top: target.offsetTop - 80, behavior: 'smooth' });
        });
    });
});
</script>
}
